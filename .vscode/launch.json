    "version": "0.2.0",
    "configurations": [
      
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}"
        },
        {
      "name": "🐍 Run Adaptive MCP Host Agent",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/agents/host_agent_executor.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "stopOnEntry": false
    }
    ]
}